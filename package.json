{
  "name": "termiwallet",
  "version": "0.2.0",
  "type": "module",
  "bin": {
    "termiwallet": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "typecheck": "bun x --bun tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "check": "bun run lint && bun run format:check",
    "fix": "bun run lint:fix && bun run format"
  },
  "dependencies": {
    "@opentui/core": "^0.7.0",
    "@opentui/qrcode": "^0.7.0",
    "@opentui/react": "^0.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "viem": "^2.57.13"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "bun-types": "^1.4.4",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  }
}